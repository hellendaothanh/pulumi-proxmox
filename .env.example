# Proxmox VE Environment Variables
PROXMOX_VE_ENDPOINT="https://192.168.1.100:8006/"
PROXMOX_VE_INSECURE="true"
PROXMOX_VE_API_TOKEN="root@pam!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Proxmox SSH Configuration (Bắt buộc khi import custom disk/cloud image vào VM)
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-root-proxmox-password"
# Hoặc dùng private key thay cho password:
# PROXMOX_VE_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."
