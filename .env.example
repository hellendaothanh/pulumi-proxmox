# Proxmox VE Environment Variables
PROXMOX_VE_ENDPOINT="https://192.168.1.100:8006/"
PROXMOX_VE_INSECURE="true"
PROXMOX_VE_API_TOKEN="root@pam!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Proxmox SSH Configuration (Bắt buộc khi import custom disk/cloud image vào VM)
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-root-proxmox-password"
# Hoặc dùng private key thay cho password:
# PROXMOX_VE_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."

# ==========================================
# ENTERPRISE SSO & IDENTITY PROVIDERS (OIDC / OAuth2)
# ==========================================
PORTAL_BASE_URL="http://localhost:3000"
SESSION_SECRET="proxmox-portal-sso-secret-change-in-production"

# 1. OpenID Connect (Keycloak / Authelia / Okta / Authentik / GitLab)
OIDC_ENABLED="false"
OIDC_NAME="Keycloak SSO"
OIDC_ISSUER_URL="https://auth.yourdomain.com/realms/master"
OIDC_CLIENT_ID="proxmox-portal"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_SCOPES="openid profile email"
OIDC_GROUP_CLAIM="groups"
OIDC_ADMIN_GROUPS="proxmox-admins,devops-leads"
OIDC_DEV_GROUPS="developers,devsecops"

# 2. Google Workspace OAuth2
GOOGLE_OAUTH_ENABLED="false"
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_ALLOWED_DOMAINS="yourcompany.com"
GOOGLE_ADMIN_EMAILS="admin@yourcompany.com,devops-lead@yourcompany.com"
GOOGLE_DEV_EMAILS="dev1@yourcompany.com,dev2@yourcompany.com"

# 3. GitHub OAuth
GITHUB_OAUTH_ENABLED="false"
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_ALLOWED_ORGS="your-company-org"
GITHUB_ADMIN_TEAMS="devops,infrastructure"
GITHUB_DEV_TEAMS="engineering,developers"

# 4. Local Break-Glass Fallback Accounts
AUTH_LOCAL_ENABLED="true"
AUTH_ADMIN_USERNAME="admin"
AUTH_ADMIN_PASSWORD="Admin@123"
AUTH_DEV_USERNAME="developer"
AUTH_DEV_PASSWORD="dev123"
AUTH_VIEWER_USERNAME="viewer"
AUTH_VIEWER_PASSWORD="view123"

